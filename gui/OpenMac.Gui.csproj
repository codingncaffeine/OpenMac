<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net11.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <AssemblyName>OpenMac</AssemblyName>
    <RootNamespace>OpenMac.Gui</RootNamespace>
    <ApplicationIcon>..\shell\assets\openmac.ico</ApplicationIcon>
    <Product>OpenMac</Product>
    <AssemblyTitle>OpenMac</AssemblyTitle>
    <UseWindowsForms>false</UseWindowsForms>
    <Version>0.7.1</Version>
  </PropertyGroup>

  <!-- Ship the native core DLL (built by CMake into gui/native) beside the app.
       CopyToOutputDirectory covers a local build; publish is a separate copy
       step, and without CopyToPublishDirectory a published tree is an app with
       no emulator in it. -->
  <ItemGroup>
    <None Include="native\openmac_c.dll" Condition="Exists('native\openmac_c.dll')">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
      <Link>openmac_c.dll</Link>
    </None>
  </ItemGroup>

  <!-- The .NET 11 preview SDK leaves ijwhost.dll out of a self-contained publish.
       WPF's DirectWriteForwarder.dll is a mixed-mode assembly that loads it, so
       without it the published app dies before its first window (0xE0434352,
       FileNotFoundException for DirectWriteForwarder.dll) on any PC where no
       installed .NET happens to supply one. Put the host pack's copy in the
       publish set, and refuse to publish without it. -->
  <Target Name="PublishIjwHost"
          BeforeTargets="ComputeResolvedFilesToPublishList;_ComputeFilesToBundle"
          Condition="'$(SelfContained)' == 'true'">
    <PropertyGroup>
      <IjwHostPath>$(NetCoreRoot)packs\Microsoft.NETCore.App.Host.$(RuntimeIdentifier)\$(BundledNETCoreAppPackageVersion)\runtimes\$(RuntimeIdentifier)\native\ijwhost.dll</IjwHostPath>
    </PropertyGroup>
    <Error Condition="!Exists('$(IjwHostPath)')"
           Text="ijwhost.dll was not found at $(IjwHostPath); a self-contained publish without it cannot start." />
    <ItemGroup>
      <ResolvedFileToPublish Include="$(IjwHostPath)" RelativePath="ijwhost.dll"
                             CopyToPublishDirectory="PreserveNewest" />
    </ItemGroup>
  </Target>

</Project>
