<Window x:Class="OpenMac.Gui.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="OpenMac" Height="560" Width="760" MinWidth="360" MinHeight="300"
        Background="{StaticResource WindowBg}" Foreground="{StaticResource TextPrimary}"
        FontFamily="Segoe UI" FontSize="13"
        AllowDrop="True" Drop="Window_Drop" DragOver="Window_DragOver">
    <DockPanel>
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="Open ROM…" InputGestureText="Ctrl+O" Click="OpenRom_Click" />
                <MenuItem x:Name="RecentMenu" Header="Open Recent" />
                <Separator />
                <MenuItem x:Name="WriteProtectItem" Header="Write-Protect Floppies"
                          IsCheckable="True" Click="WriteProtectFloppies_Click"
                          ToolTip="Locks the tab on every floppy, the way a locked disk is locked. Turn this off to let the Mac save changes back into the image file it came from." />
                <MenuItem Header="Insert Floppy in Internal Drive…" Click="InsertFloppy_Click" />
                <MenuItem x:Name="EjectFloppyItem" Header="Eject Floppy from Internal Drive"
                          Click="EjectFloppy_Click" />
                <Separator />
                <MenuItem x:Name="ExternalDriveItem" Header="External Drive Connected"
                          IsCheckable="True" Click="ExternalDrive_Click" />
                <MenuItem Header="Insert Floppy in External Drive…" Click="InsertExternalFloppy_Click" />
                <MenuItem x:Name="EjectFloppy2Item" Header="Eject Floppy from External Drive"
                          Click="EjectExternalFloppy_Click" />
                <Separator />
                <MenuItem Header="Attach Hard Disk…" Click="AttachHardDisk_Click" />
                <MenuItem Header="Create Hard Disk…" Click="CreateHardDisk_Click" />
                <MenuItem x:Name="DetachHdItem" Header="Detach Hard Disk" Click="DetachHardDisk_Click" />
                <Separator />
                <MenuItem x:Name="CdDriveItem" Header="CD-ROM Drive Connected"
                          IsCheckable="True" Click="CdDrive_Click"
                          ToolTip="Puts an AppleCD SC-class drive on the SCSI bus. The Mac finds it during its startup bus scan, so connecting one wants a restart; discs can then go in and out any time." />
                <MenuItem Header="Insert CD Image…" Click="InsertCd_Click" />
                <MenuItem x:Name="EjectCdItem" Header="Eject CD" Click="EjectCd_Click" />
                <Separator />
                <MenuItem Header="Open Host Folder as Disk…" Click="OpenFolderDisk_Click"
                          ToolTip="Builds a real HFS disk from a folder on this PC and puts it on the SCSI bus. Changes the Mac makes come back to the folder when the disk is closed, the machine restarts, or OpenMac quits." />
                <MenuItem x:Name="CloseFolderDiskItem" Header="Close Folder Disk"
                          Click="CloseFolderDisk_Click" />
                <Separator />
                <MenuItem Header="Exit" InputGestureText="Alt+F4" Click="Exit_Click" />
            </MenuItem>
            <MenuItem Header="_Machine">
                <MenuItem Header="Model">
                    <MenuItem x:Name="ModelClassicItem" Header="Macintosh Classic"
                              Click="ModelClassic_Click" />
                    <MenuItem x:Name="ModelQuadraItem" Header="Macintosh Quadra 650"
                              Click="ModelQuadra_Click"
                              ToolTip="68040 @ 33 MHz with color DAFB video. Needs the 1 MB Quadra 650 family ROM and boots from a SCSI hard disk; each model remembers its own ROM and disk." />
                </MenuItem>
                <MenuItem x:Name="MonitorMenu" Header="Monitor"
                          ToolTip="Which display is plugged into the video port. An Apple monitor of this era runs one resolution, so choosing the monitor chooses the resolution. The ROM senses it at startup, so the machine restarts." />
                <Separator />
                <MenuItem Header="Reset" InputGestureText="Ctrl+R" Click="Reset_Click" />
                <Separator />
                <MenuItem x:Name="Mem1Item" Header="1 MB RAM" Tag="1" Click="Memory_Click" />
                <MenuItem x:Name="Mem2Item" Header="2 MB RAM" Tag="2" Click="Memory_Click" />
                <MenuItem x:Name="Mem4Item" Header="4 MB RAM" Tag="4" Click="Memory_Click" />
                <MenuItem x:Name="MemQ8Item" Header="8 MB RAM" Tag="8" Click="MemoryQuadra_Click" />
                <MenuItem x:Name="MemQ16Item" Header="16 MB RAM" Tag="16" Click="MemoryQuadra_Click" />
                <MenuItem x:Name="MemQ32Item" Header="32 MB RAM" Tag="32" Click="MemoryQuadra_Click" />
                <MenuItem x:Name="MemQ64Item" Header="64 MB RAM" Tag="64" Click="MemoryQuadra_Click" />
                <MenuItem x:Name="MemQ128Item" Header="128 MB RAM" Tag="128" Click="MemoryQuadra_Click" />
                <MenuItem x:Name="MemQ136Item" Header="136 MB RAM (max)" Tag="136" Click="MemoryQuadra_Click" />
                <Separator />
                <MenuItem x:Name="BootRomDiskItem" Header="Boot from ROM Disk (Cmd-Opt-X-O)"
                          Click="BootRomDisk_Click" />
                <Separator />
                <MenuItem x:Name="NetworkingItem" Header="Networking (DaynaPORT at SCSI 4)"
                          IsCheckable="True" Click="Networking_Click"
                          ToolTip="Puts a DaynaPORT SCSI/Link Ethernet adapter on the bus, backed by user-mode NAT — no drivers or admin rights on this PC. Inside the Mac, install the Dayna SCSI/Link driver and MacTCP, set MacTCP to BOOTP (or manually to 10.0.2.15, router 10.0.2.2, DNS 10.0.2.3), and restart." />
            </MenuItem>
            <MenuItem Header="_Key Combos">
                <MenuItem Header="Quit Application" InputGestureText="⌘Q" Tag="cmd+q" Click="SendCombo_Click" />
                <MenuItem Header="Close Window" InputGestureText="⌘W" Tag="cmd+w" Click="SendCombo_Click" />
                <MenuItem Header="Force Quit" InputGestureText="⌘⌥Esc" Tag="cmd+opt+esc" Click="SendCombo_Click" />
                <MenuItem Header="Cancel / Stop" InputGestureText="⌘." Tag="cmd+period" Click="SendCombo_Click" />
                <Separator />
                <MenuItem Header="New" InputGestureText="⌘N" Tag="cmd+n" Click="SendCombo_Click" />
                <MenuItem Header="Open" InputGestureText="⌘O" Tag="cmd+o" Click="SendCombo_Click" />
                <MenuItem Header="Save" InputGestureText="⌘S" Tag="cmd+s" Click="SendCombo_Click" />
                <MenuItem Header="Print" InputGestureText="⌘P" Tag="cmd+p" Click="SendCombo_Click" />
                <Separator />
                <MenuItem Header="Undo" InputGestureText="⌘Z" Tag="cmd+z" Click="SendCombo_Click" />
                <MenuItem Header="Cut" InputGestureText="⌘X" Tag="cmd+x" Click="SendCombo_Click" />
                <MenuItem Header="Copy" InputGestureText="⌘C" Tag="cmd+c" Click="SendCombo_Click" />
                <MenuItem Header="Paste" InputGestureText="⌘V" Tag="cmd+v" Click="SendCombo_Click" />
                <MenuItem Header="Select All" InputGestureText="⌘A" Tag="cmd+a" Click="SendCombo_Click" />
                <Separator />
                <MenuItem Header="Eject Internal Floppy" InputGestureText="⌘⇧1" Tag="cmd+shift+1" Click="SendCombo_Click" />
                <MenuItem Header="Eject External Floppy" InputGestureText="⌘⇧2" Tag="cmd+shift+2" Click="SendCombo_Click" />
                <MenuItem Header="Screen Snapshot to Disk" InputGestureText="⌘⇧3" Tag="cmd+shift+3" Click="SendCombo_Click" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem x:Name="ScaleFitItem" Header="Fit Window" Tag="0" Click="Scale_Click" />
                <MenuItem x:Name="Scale1Item" Header="1×  (512 × 342)" Tag="1" Click="Scale_Click" />
                <MenuItem x:Name="Scale2Item" Header="2×  (1024 × 684)" Tag="2" Click="Scale_Click" />
                <MenuItem x:Name="Scale3Item" Header="3×  (1536 × 1026)" Tag="3" Click="Scale_Click" />
                <Separator />
                <MenuItem Header="Fullscreen" InputGestureText="F11" Click="Fullscreen_Click" />
                <MenuItem Header="Debugger…" Click="Debugger_Click" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="Capture Diagnostics…" Click="CaptureDiagnostics_Click"
                          ToolTip="Save a snapshot of what the machine is doing — take it while it is misbehaving." />
                <Separator />
                <MenuItem Header="About OpenMac" Click="About_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Bottom" Background="{StaticResource Surface}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="10,3">
            <Grid>
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="StatusState" Text="Stopped" Foreground="{StaticResource TextSecondary}" />
                    <TextBlock Text="   " />
                    <TextBlock x:Name="StatusMachine" Text="No ROM loaded" Foreground="{StaticResource TextSecondary}" />
                </StackPanel>
                <TextBlock x:Name="StatusBackend" HorizontalAlignment="Right" Text="core: stub"
                           Foreground="{StaticResource TextSecondary}" />
            </Grid>
        </Border>

        <Grid x:Name="ScreenHost" Background="{StaticResource Letterbox}">
            <Viewbox Stretch="Uniform" StretchDirection="Both">
                <Image x:Name="ScreenImage" Width="512" Height="342"
                       RenderOptions.BitmapScalingMode="NearestNeighbor" />
            </Viewbox>
            <Border x:Name="Overlay" Background="#D0121214">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="OpenMac" FontSize="42" FontWeight="Bold"
                               Foreground="{StaticResource TextPrimary}" HorizontalAlignment="Center" />
                    <Border Width="66" Height="3" Background="{StaticResource Accent}"
                            Margin="0,12" HorizontalAlignment="Center" />
                    <TextBlock Text="Macintosh Classic emulator" FontSize="14"
                               Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                    <TextBlock Text="File  ▸  Open ROM  to begin" Margin="0,16,0,0"
                               Foreground="{StaticResource TextSecondary}" HorizontalAlignment="Center" />
                </StackPanel>
            </Border>
        </Grid>
    </DockPanel>
</Window>
